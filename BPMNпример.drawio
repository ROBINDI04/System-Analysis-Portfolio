<mxfile host="Electron" modified="2024-05-24T17:00:00.000Z" agent="Mozilla/5.0" version="21.2.8" type="device">
  <diagram id="bpmn_example" name="Пример BPMN">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ПУЛ: КЛИЕНТ -->
        <mxCell id="pool_client" value="Клиент" style="swimlane;html=1;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;horizontal=1;startSize=30;horizontalStack=0;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="100" y="80" width="900" height="140" as="geometry" />
        </mxCell>
        
        <!-- Стартовое событие -->
        <mxCell id="c_start" value="Заказ создан" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="pool_client">
          <mxGeometry x="50" y="50" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- Задача Клиента -->
        <mxCell id="c_task" value="Выбрать товар" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="pool_client">
          <mxGeometry x="200" y="40" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Конечное событие -->
        <mxCell id="c_end" value="Заказ получен" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=4;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="pool_client">
          <mxGeometry x="750" y="50" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- ПУЛ: МАГАЗИН -->
        <mxCell id="pool_shop" value="Интернет-магазин" style="swimlane;html=1;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;horizontal=1;startSize=30;horizontalStack=0;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="100" y="260" width="900" height="380" as="geometry" />
        </mxCell>

        <!-- Дорожка Оператор -->
        <mxCell id="lane_op" value="Оператор" style="swimlane;html=1;startSize=30;horizontal=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;swimlaneLine=1;fontSize=12;" vertex="1" parent="pool_shop">
          <mxGeometry y="30" width="900" height="170" as="geometry" />
        </mxCell>
        
        <!-- Дорожка Система -->
        <mxCell id="lane_sys" value="Система" style="swimlane;html=1;startSize=30;horizontal=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;swimlaneLine=1;fontSize=12;" vertex="1" parent="pool_shop">
          <mxGeometry y="200" width="900" height="180" as="geometry" />
        </mxCell>

        <!-- Задача Оператора -->
        <mxCell id="op_task" value="Проверить заказ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;arcSize=12;" vertex="1" parent="lane_op">
          <mxGeometry x="200" y="40" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Шлюз Оператора -->
        <mxCell id="op_gw" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="lane_op">
          <mxGeometry x="420" y="45" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="op_gw_x" value="X" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;" vertex="1" connectable="0" parent="lane_op">
          <mxGeometry x="435" y="60" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="op_gw_lbl" value="Товар есть?" style="text;html=1;align=center;verticalAlign=top;fontSize=12;" vertex="1" connectable="0" parent="lane_op">
          <mxGeometry x="395" y="100" width="100" height="20" as="geometry" />
        </mxCell>

        <!-- Задача Системы (Успех) -->
        <mxCell id="sys_task_ok" value="Зарезервировать товар" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;arcSize=12;" vertex="1" parent="lane_sys">
          <mxGeometry x="520" y="60" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Задача Системы (Отмена) -->
        <mxCell id="sys_task_fail" value="Отменить заказ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="lane_sys">
          <mxGeometry x="200" y="60" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- СВЯЗИ -->
        <!-- Клиент: Старт -> Задача -->
        <mxCell id="link1" edge="1" parent="pool_client" source="c_start" target="c_task" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Клиент: Задача -> Конец -->
        <mxCell id="link2" edge="1" parent="pool_client" source="c_task" target="c_end" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ИСХОДЯЩЕЕ сообщение (Клиент -> Оператор) - пунктир -->
        <mxCell id="link_msg_out" edge="1" parent="1" source="c_task" target="op_task" 
                style="endArrow=block;html=1;dashed=1;dashPattern=1 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;edgeStyle=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Оператор: Задача -> Шлюз -->
        <mxCell id="link_op_task" edge="1" parent="lane_op" source="op_task" target="op_gw" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Шлюз -> Успех (Да) -->
        <mxCell id="link_ok" edge="1" parent="pool_shop" source="op_gw" target="sys_task_ok" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="210" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="label_ok" value="Да" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" vertex="1" connectable="0" parent="pool_shop">
          <mxGeometry x="510" y="200" width="30" height="20" as="geometry" />
        </mxCell>

        <!-- Шлюз -> Отмена (Нет) -->
        <mxCell id="link_fail" edge="1" parent="pool_shop" source="op_gw" target="sys_task_fail" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="260" y="210" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="label_fail" value="Нет" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" vertex="1" connectable="0" parent="pool_shop">
          <mxGeometry x="250" y="200" width="30" height="20" as="geometry" />
        </mxCell>

        <!-- ИСПРАВЛЕННАЯ СВЯЗЬ: ОТВЕТНОЕ сообщение (Система -> Клиент) -->
        <!-- Делаем её пунктирной (dashed=1) и с открытой стрелкой (endArrow=open), как требует BPMN -->
        <mxCell id="link_end" edge="1" parent="1" source="sys_task_ok" target="c_end" 
                style="endArrow=open;html=1;dashed=1;dashPattern=1 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;edgeStyle=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>